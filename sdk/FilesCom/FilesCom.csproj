<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 is the asset .NET Framework 4.8 and 4.8.1 applications use. -->
    <TargetFrameworks>net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>FilesCom</PackageId>
    <Version>2.0.14</Version>
    <Authors>Files.com - support@files.com - https://www.files.com/</Authors>
    <Title>Files.com Client</Title>
    <Description>The Files.com .NET Client library provides convenient access to the Files.com API from applications using the .NET framework.</Description>
    <Copyright>Copyright 2020-2025</Copyright>
    <PackageProjectUrl>https://github.com/Files-com/files-sdk-dotnet/tree/master/sdk/FilesCom</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>
      Files.com releases contain API improvements, bugfixes, and more.
    </PackageReleaseNotes>
    <PackageTags>Files Files.com FTP SFTP SCP WebDAV</PackageTags>
    <!-- Ships FilesCom.xml beside each assembly, so editors show the documentation of installed packages. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Some public types and members, such as the generated model classes, have no documentation comment yet. Malformed comments still warn. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <!--
    The package is built with -c Production (build.sh, and the release job's pack), a configuration only this project
    names: optimized, as Release is, with its own PRODUCTION constant.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Production'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.5.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
    <!-- The retry strategy the SDK configures itself for every request it retries (Http/RetryPolicy.cs). -->
    <PackageReference Include="Polly.Core" Version="8.8.0" />
    <!-- Each client's own IHttpClientFactory and the service provider it lives in (Http/ClientTransport.cs). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
  <!-- .NET 10 includes this System.Text.Json version in its shared framework. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>
  <!--
    FilesList.ListAutoPagingAsync returns IAsyncEnumerable, and FilesClient implements IAsyncDisposable, which .NET
    Standard 2.0 lacks. This package supplies them, and the async iterator support C# 8 needs, to that build and to
    the .NET Framework applications that use it. .NET 8 and 10 include them.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Util/path_comparison.json" LogicalName="FilesCom.Util.path_comparison.json" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
