<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs on each supported modern runtime; each needs that runtime installed. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- WriterProcess.Main is the entry point, for the child processes tests start with dotnet exec; the test host
         runs the tests as it does without one. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- When CI tests the frameworks at the same time (test.sh, TestTfmsInParallel), it names in FilesTestsFrameworkTemp
       a directory holding a temporary directory for each framework, and each framework's test host gets its own as
       TMPDIR (VSTest's RunConfiguration.EnvironmentVariables): tests that look at what is in the temporary directory
       then see only their own host's files, as when the frameworks run one after another. Unset, nothing changes. -->
  <PropertyGroup Condition="'$(FilesTestsFrameworkTemp)' != ''">
    <VSTestCLIRunSettings>$(VSTestCLIRunSettings);RunConfiguration.EnvironmentVariables.TMPDIR=$(FilesTestsFrameworkTemp)/$(TargetFramework)</VSTestCLIRunSettings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="WireMock.Net.Minimal" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FilesCom/FilesCom.csproj" />
  </ItemGroup>
</Project>
