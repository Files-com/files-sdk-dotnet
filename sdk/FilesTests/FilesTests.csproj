<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs on each supported modern runtime; each needs that runtime installed. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- WriterProcess.Main is the entry point, for the child processes tests start with dotnet exec; the test host
         runs the tests as it does without one. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="WireMock.Net.Minimal" Version="2.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FilesCom/FilesCom.csproj" />
  </ItemGroup>
</Project>
