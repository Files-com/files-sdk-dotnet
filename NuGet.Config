<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restores here take their vulnerability data from nuget.org, whatever their package sources (Directory.Build.props). -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
