<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ClientJourney</RootNamespace>
    <!-- The newest FilesCom release. Set FilesComVersion to build against another, such as a local package. -->
    <FilesComVersion Condition="'$(FilesComVersion)' == ''">*</FilesComVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FilesCom" Version="$(FilesComVersion)" />
  </ItemGroup>
</Project>
