<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FilesCli</RootNamespace>
    <!-- The FilesCom version this example is written for; releases set it. Set FilesComVersion to build against another, such as a local package. -->
    <FilesComVersion Condition="'$(FilesComVersion)' == ''">2.0.3</FilesComVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FilesCom" Version="$(FilesComVersion)" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
</Project>
